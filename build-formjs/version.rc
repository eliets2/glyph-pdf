// INF03: Windows VERSIONINFO resource for PdfWorkstation.exe.
// The version is configured from the root CMakeLists project() VERSION by
// CMake — the single authoritative source shared with WiX package metadata,
// the portable ZIP name and the portable README. This makes the built
// artifact's own metadata assertable (packaging checks the binary, not a
// CMake variable).
#include <windows.h>

#define VER_FILEVERSION             1,3,2,3
#define VER_FILEVERSION_STR         "1.3.2.3\0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    VER_FILEVERSION
 PRODUCTVERSION VER_FILEVERSION
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Glyph"
            VALUE "FileDescription",  "GlyphPDF - Open-Source PDF Workstation"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "GlyphPDF"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Glyph. Apache License 2.0."
            VALUE "OriginalFilename", "PdfWorkstation.exe"
            VALUE "ProductName",      "GlyphPDF"
            VALUE "ProductVersion",   VER_FILEVERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
