{
  "version": "1.2.0",
  "description": "Open-source privacy-first PDF workstation for Windows. Secure redaction, PAdES signatures, MRC compression, OCR ensemble. Apache-2.0.",
  "homepage": "https://github.com/eliets2/glyph-pdf",
  "license": "Apache-2.0",
  "architecture": {
    "64bit": {
      "url": "https://github.com/eliets2/glyph-pdf/releases/download/v1.2.0/GlyphPDF-1.2.0-x64.msi",
      "hash": "sha256:EA2ED66C256C3346E9ABAF300AB34F1191D1116EFC88BA1DC38AB0B354116BCA"
    }
  },
  "installer": {
    "script": [
      "$msi = \"$dir\\GlyphPDF-1.2.0-x64.msi\"",
      "Start-Process msiexec -ArgumentList \"/i\", \"$msi\", \"/quiet\", \"/norestart\", \"INSTALLDIR=$dir\" -Wait -NoNewWindow"
    ]
  },
  "uninstaller": {
    "script": [
      "Start-Process msiexec -ArgumentList \"/x\", \"{C1F384AE-8A11-4770-B1BB-86A80F53F713}\", \"/quiet\", \"/norestart\" -Wait -NoNewWindow"
    ]
  },
  "bin": [
    ["GlyphPDF.exe", "glyphpdf"]
  ],
  "shortcuts": [
    ["GlyphPDF.exe", "GlyphPDF"]
  ],
  "persist": [],
  "checkver": {
    "url": "https://api.github.com/repos/eliets2/glyph-pdf/releases/latest",
    "jsonpath": "$.tag_name",
    "regex": "v([\\d.]+)"
  },
  "autoupdate": {
    "architecture": {
      "64bit": {
        "url": "https://github.com/eliets2/glyph-pdf/releases/download/v$version/GlyphPDF-$version-x64.msi",
        "hash": {
          "url": "https://github.com/eliets2/glyph-pdf/releases/download/v$version/GlyphPDF-$version-x64.msi.sha256",
          "find": "([a-fA-F0-9]{64})"
        }
      }
    }
  },
  "notes": [
    "Optional: install LibreOffice for Office-to-PDF import.",
    "Optional: install Ollama for local AI assistant without an API key."
  ]
}
