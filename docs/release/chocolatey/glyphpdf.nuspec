<?xml version="1.0" encoding="utf-8"?>
<!--
  Chocolatey package spec for GlyphPDF v1.2.1

  To build: choco pack glyphpdf.nuspec
  To push:  choco push glyphpdf.1.2.1.nupkg --source https://push.chocolatey.org --api-key YOUR_KEY

  Install script lives at tools/chocolateyInstall.ps1 (create alongside this file).
-->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>glyphpdf</id>
    <version>1.2.1</version>
    <title>GlyphPDF</title>
    <authors>Glyph</authors>
    <projectUrl>https://github.com/eliets2/glyph-pdf</projectUrl>
    <iconUrl>https://raw.githubusercontent.com/eliets2/glyph-pdf/main/resources/branding/icon-256.png</iconUrl>
    <licenseUrl>https://github.com/eliets2/glyph-pdf/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/eliets2/glyph-pdf</projectSourceUrl>
    <bugTrackerUrl>https://github.com/eliets2/glyph-pdf/issues</bugTrackerUrl>
    <tags>pdf pdf-editor pdf-viewer ocr redaction digital-signatures privacy open-source admin</tags>
    <summary>Open-source privacy-first PDF workstation for Windows. Apache-2.0.</summary>
    <description><![CDATA[
GlyphPDF is a full-featured, open-source PDF workstation for Windows.

## Features

- **Secure redaction** with Edact-Ray glyph-advance normalization (closes arXiv 2206.02285 side-channel)
- **PAdES B-LT/B-LTA digital signatures** with real trust-chain + OCSP verification
- **MRC layered compression**: JBIG2 + JPEG2000 + OCR sandwich text — 30x compression, PDF/A-2b
- **OCR ensemble**: PP-DocLayoutV2 layout + Tesseract 5 + RapidOCR PP-OCRv5 + ROVER fusion
- **Djot document interchange**: semantic dual-model with provenance tracking
- **AI assistant**: Anthropic Claude, OpenAI GPT-4o, Gemini, Ollama (local)
- **Office import**: .docx/.xlsx/.pptx via LibreOffice subprocess
- **Batch processing**, **Form Builder** (9 field types), **Compare mode** with Myers LCS diff
- No telemetry, no cloud upload, no subscription
- Apache-2.0 licensed

## v1.2.1 Fixes

- Fixed startup crash on all v1.0.x and v1.2.0 installs: deploy.ps1 was bundling
  the ABI-incompatible MSYS2 podofo 0.10.4 instead of the vendored podofo 1.1.0
  that GlyphPDF.exe was linked against, causing "Entry Point Not Found" on launch.

## v1.2.0 Security Fixes (included)

- Removed OCSP test-fixture bypass from production builds (SECFIX-1)
- Fixed AES-256-GCM downgrade oracle via unauthenticated version byte (SECFIX-2)
- Fixed TOCTOU in MSI update verification (SECFIX-3)
- Fixed unbounded recursion in signature shadow-attack detector (SECFIX-4)
- Restricted Ollama AI provider to localhost/HTTPS endpoints (SECFIX-5)

## Notes

- Optional dependencies: LibreOffice (Office import), Ollama (local AI)
- 64-bit Windows 10 (1607+) or Windows 11 required
    ]]></description>
    <releaseNotes>https://github.com/eliets2/glyph-pdf/releases/tag/v1.2.1</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>

<!-- Place install script at chocolatey/tools/chocolateyInstall.ps1:

$ErrorActionPreference = 'Stop'
$packageName = 'glyphpdf'
$url64       = 'https://github.com/eliets2/glyph-pdf/releases/download/v1.2.1/GlyphPDF-1.2.1-x64.msi'
$checksum64  = 'A4B16DD2080FE2F6EA3E1CD81966865322EEFAB78BE31169F1319161DD7644DC'

$packageArgs = @{
  packageName    = $packageName
  fileType       = 'MSI'
  url64bit       = $url64
  checksum64     = $checksum64
  checksumType64 = 'sha256'
  silentArgs     = '/quiet /norestart'
  validExitCodes = @(0, 3010)
}
Install-ChocolateyPackage @packageArgs
-->
